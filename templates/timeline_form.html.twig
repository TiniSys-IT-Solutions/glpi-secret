{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ path('plugins/secret/Itil/Secret') }}" class="plugin-secret-create-form" autocomplete="off">
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
   <input type="hidden" name="itemtype" value="{{ subitem.fields.itemtype }}">
   <input type="hidden" name="items_id" value="{{ subitem.fields.items_id }}">

   <div class="plugin-secret-form-heading d-flex align-items-start gap-3 mb-4">
      <span class="plugin-secret-form-icon" aria-hidden="true"><i class="ti ti-shield-lock"></i></span>
      <div>
         <h3 class="mb-1">{{ __('Protect sensitive information', 'secret') }}</h3>
         <p class="text-secondary mb-0">{{ __('The value is encrypted and never added to the ticket timeline or notifications.', 'secret') }}</p>
      </div>
   </div>

   <div class="plugin-secret-section">
      <div class="plugin-secret-section-title">
         <i class="ti ti-key"></i>
         <span>{{ __('Secret details', 'secret') }}</span>
      </div>
      <div class="row g-3">
      <div class="col-md-8">
         <label class="form-label required" for="secret-name">{{ __('Name') }}</label>
         <input class="form-control" id="secret-name" name="name" maxlength="255" required>
      </div>
      <div class="col-md-4">
         <label class="form-label required" for="secret-type">{{ __('Type') }}</label>
         <select class="form-select plugin-secret-type" id="secret-type" name="type" required>
            <option value="password">{{ __('Password', 'secret') }}</option>
            <option value="credential">{{ __('Username and password', 'secret') }}</option>
            <option value="token">{{ __('Token', 'secret') }}</option>
            <option value="other">{{ __('Sensitive information', 'secret') }}</option>
         </select>
      </div>
      <div class="col-md-6 plugin-secret-username-field" hidden>
         <label class="form-label" for="secret-username">{{ __('Username', 'secret') }}</label>
         <input class="form-control" id="secret-username" name="username" maxlength="255" autocomplete="off">
      </div>
      <div class="col-12">
         <label class="form-label required" for="secret-value">{{ _n('Secret', 'Secrets', 1, 'secret') }}</label>
         <div class="input-group plugin-secret-password-value">
            <input type="password" class="form-control font-monospace plugin-secret-value-input" id="secret-value" name="secret_value"
                   maxlength="{{ subitem.fields.config.max_secret_length }}" required autocomplete="new-password"
                   spellcheck="false">
            <button class="btn btn-outline-secondary plugin-secret-toggle" type="button" data-target="secret-value"
                    title="{{ __('Show or hide', 'secret') }}"><i class="ti ti-eye"></i></button>
            <button class="btn btn-outline-secondary plugin-secret-copy-input" type="button" data-target="secret-value"
                    title="{{ __('Copy') }}"><i class="ti ti-copy"></i></button>
            <button class="btn btn-outline-secondary plugin-secret-generate" type="button" data-target="secret-value"
                    title="{{ __('Generate', 'secret') }}"><i class="ti ti-refresh"></i></button>
         </div>
         <textarea class="form-control font-monospace plugin-secret-sensitive-value" name="secret_value" hidden
                   maxlength="{{ subitem.fields.config.max_secret_length }}" rows="6" disabled
                   autocomplete="off" spellcheck="false"
                   aria-label="{{ __('Sensitive information', 'secret') }}"></textarea>
      </div>
      <div class="col-12 plugin-secret-generator-options"
           data-length="{{ subitem.fields.config.generator_length }}"
           data-lowercase="{{ subitem.fields.config.generator_lowercase ? '1' : '0' }}"
           data-uppercase="{{ subitem.fields.config.generator_uppercase ? '1' : '0' }}"
           data-digits="{{ subitem.fields.config.generator_digits ? '1' : '0' }}"
           data-special="{{ subitem.fields.config.generator_special ? '1' : '0' }}"
           data-exclude-ambiguous="{{ subitem.fields.config.generator_exclude_ambiguous ? '1' : '0' }}">
         <details class="plugin-secret-details">
            <summary><i class="ti ti-adjustments-horizontal me-1"></i>{{ __('Password generator options', 'secret') }}</summary>
            <div class="d-flex flex-wrap gap-3 mt-3 align-items-center">
               <label class="d-flex align-items-center gap-2">{{ __('Length', 'secret') }} <input type="number" class="form-control form-control-sm plugin-secret-length" min="8" max="256" value="{{ subitem.fields.config.generator_length }}"></label>
               {% for key, label in {
                  'lowercase': __('Lowercase', 'secret'),
                  'uppercase': __('Uppercase', 'secret'),
                  'digits': __('Digits', 'secret'),
                  'special': __('Special characters', 'secret'),
                  'exclude-ambiguous': __('Exclude ambiguous characters', 'secret')
               } %}
                  <label class="form-check mb-0">
                     <input class="form-check-input plugin-secret-generator-{{ key }}" type="checkbox"
                            {{ attribute(subitem.fields.config, 'generator_' ~ key|replace({'-': '_'})) ? 'checked' : '' }}>
                     <span class="form-check-label">{{ label }}</span>
                  </label>
               {% endfor %}
            </div>
         </details>
      </div>
      </div>
   </div>

   <div class="plugin-secret-section mt-3">
      <div class="plugin-secret-section-title">
         <i class="ti ti-user-shield"></i>
         <span>{{ __('Access and lifetime', 'secret') }}</span>
      </div>
      <div class="row g-3">
      <div class="col-md-6">
         <label class="form-label required" for="secret-visibility">{{ __('Visibility', 'secret') }}</label>
         <select class="form-select plugin-secret-visibility" id="secret-visibility" name="visibility" required>
            <option value="owner" {{ subitem.fields.config.default_visibility == 'owner' ? 'selected' : '' }}>{{ __('Me only', 'secret') }}</option>
            <option value="ticket_technicians" {{ subitem.fields.config.default_visibility == 'ticket_technicians' ? 'selected' : '' }}>{{ __('Assigned technicians', 'secret') }}</option>
            <option value="requesters_and_technicians" {{ subitem.fields.config.default_visibility == 'requesters_and_technicians' ? 'selected' : '' }}>{{ __('Requester and technicians', 'secret') }}</option>
            <option value="group" {{ subitem.fields.config.default_visibility == 'group' ? 'selected' : '' }}>{{ __('Group') }}</option>
         </select>
      </div>
      <div class="col-md-6 plugin-secret-group-field">
         {{ fields.dropdownField('Group', 'groups_id', 0, __('Group'), {
            entity: subitem.fields.entities_id,
            full_width: true,
            condition: {'is_assign': 1}
         }) }}
      </div>
      <div class="col-md-6">
         <label class="form-label required" for="secret-expiration">{{ __('Expiration') }}</label>
         <select class="form-select plugin-secret-expiration" id="secret-expiration" name="expiration_policy" required>
            <option value="never" {{ subitem.fields.config.default_expiration == 'never' ? 'selected' : '' }}>{{ __('Never') }}</option>
            <option value="ticket_closed" {{ subitem.fields.config.default_expiration == 'ticket_closed' ? 'selected' : '' }}>{{ __('When the ITIL object is closed', 'secret') }}</option>
            <option value="one_day" {{ subitem.fields.config.default_expiration == 'one_day' ? 'selected' : '' }}>{{ __('1 day', 'secret') }}</option>
            <option value="seven_days" {{ subitem.fields.config.default_expiration == 'seven_days' ? 'selected' : '' }}>{{ __('7 days', 'secret') }}</option>
            <option value="thirty_days" {{ subitem.fields.config.default_expiration == 'thirty_days' ? 'selected' : '' }}>{{ __('30 days', 'secret') }}</option>
            <option value="custom" {{ subitem.fields.config.default_expiration == 'custom' ? 'selected' : '' }}>{{ __('Custom date', 'secret') }}</option>
         </select>
      </div>
      <div class="col-md-6 plugin-secret-custom-expiration">
         <label class="form-label" for="secret-custom-expiration">{{ __('Custom expiration', 'secret') }}</label>
         <input type="datetime-local" class="form-control" id="secret-custom-expiration" name="custom_expiration">
      </div>
      </div>
   </div>

   <div class="plugin-secret-form-footer d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">
      <span class="small text-secondary"><i class="ti ti-lock-check me-1"></i>{{ __('Access is controlled and every reveal or copy is audited.', 'secret') }}</span>
      <button class="btn btn-primary plugin-secret-submit" type="submit"><i class="ti ti-lock-plus me-1"></i>{{ __('Encrypt and add', 'secret') }}</button>
   </div>
</form>
