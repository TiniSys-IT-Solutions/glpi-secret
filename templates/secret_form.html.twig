{% import 'components/form/fields_macros.html.twig' as fields %}
<div class="card">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-key me-2"></i>{{ secret.fields.name }}</h3></div>
   <div class="card-body plugin-secret-detail-content">
      <div class="row g-3">
         <div class="col-md-6"><span class="form-label">{{ __('Name') }}</span><div>{{ secret.fields.name }}</div></div>
         <div class="col-md-3"><span class="form-label">{{ __('Type') }}</span><div>{{ type_label }}</div></div>
         <div class="col-md-3"><span class="form-label">{{ __('Entity') }}</span><div>{{ get_item_name('Entity', secret.fields.entities_id) }}</div></div>
         <div class="col-md-6"><span class="form-label">{{ __('Category') }}</span><div>{{ secret.fields.plugin_secret_categories_id ? get_item_name('GlpiPlugin\\Secret\\Category', secret.fields.plugin_secret_categories_id) : '—' }}</div></div>
         <div class="col-md-3"><span class="form-label">{{ __('Visibility', 'secret') }}</span><div>{{ secret.fields.visibility }}</div></div>
         <div class="col-md-3"><span class="form-label">{{ __('Expiration') }}</span><div>{{ secret.fields.expiration ?? secret.fields.expiration_policy }}</div></div>
      </div>
      <div class="mt-4 d-flex gap-2">
         {% if can_reveal %}<button type="button" class="btn btn-primary plugin-secret-action" data-action="view" data-url="{{ path('plugins/secret/Secret/' ~ secret.getID() ~ '/Reveal') }}" data-secret-type="{{ secret.fields.type }}" data-itemtype="{{ relation.itemtype }}" data-items-id="{{ relation.items_id }}" data-csrf="{{ csrf_token(true) }}"><i class="ti ti-eye me-1"></i>{{ __('Reveal', 'secret') }}</button><button type="button" class="btn btn-outline-secondary plugin-secret-action" data-action="copy" data-url="{{ path('plugins/secret/Secret/' ~ secret.getID() ~ '/Reveal') }}" data-secret-type="{{ secret.fields.type }}" data-itemtype="{{ relation.itemtype }}" data-items-id="{{ relation.items_id }}" data-csrf="{{ csrf_token(true) }}"><i class="ti ti-copy me-1"></i>{{ __('Copy') }}</button>{% endif %}
      </div>
      <div class="plugin-secret-revealed mt-3" hidden></div>
      {% if can_update %}<details class="card border-primary mt-4"><summary class="card-header"><span class="card-title"><i class="ti ti-edit me-2"></i>{{ __('Edit') }}</span></summary><form method="post" action="{{ path('plugins/secret/Central/Secret/' ~ secret.getID()) }}"><div class="card-body row g-3"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="itemtype" value="{{ relation.itemtype }}"><input type="hidden" name="items_id" value="{{ relation.items_id }}"><input type="hidden" name="type" value="{{ secret.fields.type }}"><div class="col-md-6"><label class="form-label required">{{ __('Name') }}</label><input class="form-control" name="name" value="{{ secret.fields.name }}" required></div><div class="col-md-6">{{ fields.dropdownField('GlpiPlugin\\Secret\\Category', 'plugin_secret_categories_id', secret.fields.plugin_secret_categories_id, __('Category'), {entity: secret.fields.entities_id, entity_sons: true, full_width: true}) }}</div>{% if secret.fields.type == 'credential' %}<div class="col-md-6"><label class="form-label">{{ __('Username', 'secret') }}</label><input class="form-control" name="username" value="{{ secret.fields.username }}" maxlength="255" autocomplete="off"></div>{% endif %}<div class="col-12"><label class="form-label">{{ __('New secret value', 'secret') }}</label><div class="input-group"><input id="secret-central-value-{{ secret.getID() }}" class="form-control font-monospace plugin-secret-value-input" type="password" name="secret_value" maxlength="{{ generator.max_secret_length }}" autocomplete="new-password"><button class="btn btn-outline-secondary plugin-secret-toggle" type="button" data-target="secret-central-value-{{ secret.getID() }}" title="{{ __('Show or hide', 'secret') }}"><i class="ti ti-eye"></i></button><button class="btn btn-outline-secondary plugin-secret-generate" type="button" title="{{ __('Generate', 'secret') }}"><i class="ti ti-refresh"></i></button></div><small class="form-hint">{{ __('Leave blank to keep the current encrypted value.', 'secret') }}</small><div class="plugin-secret-generator-options d-none" data-length="{{ generator.generator_length }}" data-lowercase="{{ generator.generator_lowercase ? '1' : '0' }}" data-uppercase="{{ generator.generator_uppercase ? '1' : '0' }}" data-digits="{{ generator.generator_digits ? '1' : '0' }}" data-special="{{ generator.generator_special ? '1' : '0' }}" data-exclude-ambiguous="{{ generator.generator_exclude_ambiguous ? '1' : '0' }}"></div></div></div><div class="card-footer text-end"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button></div></form></details>{% endif %}
   </div>
   {% if can_delete %}<div class="card-footer"><div class="alert alert-warning mb-3">{{ __('Deleting this secret permanently breaks all its links. This action cannot be undone.', 'secret') }}</div><form method="post" action="{{ path('plugins/secret/Central/Secret/' ~ secret.getID()) }}" class="plugin-secret-delete-form text-end"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="operation" value="delete"><input type="hidden" name="itemtype" value="{{ relation.itemtype }}"><input type="hidden" name="items_id" value="{{ relation.items_id }}"><button class="btn btn-outline-danger" type="submit"><i class="ti ti-trash me-1"></i>{{ __('Delete permanently') }}</button></form></div>{% endif %}
</div>
