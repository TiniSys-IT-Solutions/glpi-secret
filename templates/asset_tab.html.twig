{% import 'components/form/fields_macros.html.twig' as fields %}

{% if can_create %}
<div class="card mb-4">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-lock-plus me-2"></i>{{ __('Create a secret for this asset', 'secret') }}</h3></div>
   <form method="post" action="{{ path('plugins/secret/Asset/Secret') }}" class="plugin-secret-create-form" data-create-context="asset" autocomplete="off">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="itemtype" value="{{ item.getType() }}"><input type="hidden" name="items_id" value="{{ item.getID() }}">
      <div class="card-body row g-3">
         <div class="col-md-6"><label class="form-label required">{{ __('Name') }}</label><input class="form-control" name="name" maxlength="255" required></div>
         <div class="col-md-3"><label class="form-label required">{{ __('Type') }}</label><select class="form-select plugin-secret-type" name="type" required>
            <option value="password">{{ __('Password', 'secret') }}</option><option value="credential">{{ __('Username and password', 'secret') }}</option>
            <option value="token">{{ __('Token', 'secret') }}</option><option value="other">{{ __('Sensitive information', 'secret') }}</option>
         </select></div>
         <div class="col-md-3 plugin-secret-username-field" hidden><label class="form-label">{{ __('Username', 'secret') }}</label><input class="form-control" name="username" maxlength="255" autocomplete="off"></div>
         <div class="col-12 plugin-secret-password-value"><label class="form-label required">{{ _n('Secret', 'Secrets', 1, 'secret') }}</label><div class="input-group">
            <input id="secret-asset-value" class="form-control font-monospace plugin-secret-value-input" type="password" name="secret_value" required autocomplete="new-password" maxlength="{{ generator.max_secret_length }}">
            <button class="btn btn-outline-secondary plugin-secret-toggle" type="button" data-target="secret-asset-value" title="{{ __('Show or hide', 'secret') }}"><i class="ti ti-eye"></i></button>
            <button class="btn btn-outline-secondary plugin-secret-generate" type="button" title="{{ __('Generate', 'secret') }}"><i class="ti ti-refresh"></i></button>
         </div></div>
         <textarea class="form-control font-monospace plugin-secret-sensitive-value" name="secret_value" rows="5" maxlength="{{ generator.max_secret_length }}" hidden disabled autocomplete="off" spellcheck="false"></textarea>
         <div class="plugin-secret-generator-options d-none" data-length="{{ generator.generator_length }}" data-lowercase="{{ generator.generator_lowercase ? '1' : '0' }}" data-uppercase="{{ generator.generator_uppercase ? '1' : '0' }}" data-digits="{{ generator.generator_digits ? '1' : '0' }}" data-special="{{ generator.generator_special ? '1' : '0' }}" data-exclude-ambiguous="{{ generator.generator_exclude_ambiguous ? '1' : '0' }}"></div>
         <div class="col-md-4"><label class="form-label required">{{ __('Visibility', 'secret') }}</label><select class="form-select plugin-secret-visibility" name="visibility" required>
            <option value="owner">{{ __('Me only', 'secret') }}</option><option value="asset_technical_profiles">{{ __('Authorized asset users', 'secret') }}</option><option value="group">{{ __('Group') }}</option>
         </select></div>
         <div class="col-md-4 plugin-secret-group-field" hidden>{{ fields.dropdownField('Group', 'groups_id', 0, __('Group'), {entity: item.fields.entities_id, full_width: true, condition: {'is_assign': 1}}) }}</div>
         <div class="col-md-4">{{ fields.dropdownField('GlpiPlugin\\Secret\\Category', 'plugin_secret_categories_id', 0, __('Category'), {entity: item.fields.entities_id, entity_sons: true, full_width: true}) }}</div>
         <div class="col-md-4"><label class="form-label required">{{ __('Expiration') }}</label><select class="form-select plugin-secret-expiration" name="expiration_policy" required>
            <option value="never">{{ __('Never') }}</option><option value="one_day">{{ __('1 day', 'secret') }}</option><option value="seven_days">{{ __('7 days', 'secret') }}</option><option value="thirty_days">{{ __('30 days', 'secret') }}</option><option value="custom">{{ __('Custom date', 'secret') }}</option>
         </select></div>
         <div class="col-md-4 plugin-secret-custom-expiration" hidden><label class="form-label">{{ __('Custom expiration', 'secret') }}</label><input class="form-control" type="datetime-local" name="custom_expiration"></div>
      </div>
      <div class="card-footer text-end"><button class="btn btn-primary" type="submit"><i class="ti ti-lock-plus me-1"></i>{{ __('Encrypt and add', 'secret') }}</button></div>
   </form>
</div>
{% endif %}

{% if linkable_secrets %}
<form method="post" action="{{ path('plugins/secret/Asset/Secret/' ~ linkable_secrets[0].id) }}" data-action-prefix="{{ path('plugins/secret/Asset/Secret') }}/" class="card mb-4 plugin-secret-link-form">
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="operation" value="link">
   <input type="hidden" name="itemtype" value="{{ item.getType() }}"><input type="hidden" name="items_id" value="{{ item.getID() }}">
   <div class="card-body d-flex gap-2 align-items-end"><div class="flex-grow-1"><label class="form-label">{{ __('Link an existing secret', 'secret') }}</label>
      <select class="form-select plugin-secret-link-select" required>{% for candidate in linkable_secrets %}<option value="{{ candidate.id }}">{{ candidate.name }} — {{ candidate.type_label }}</option>{% endfor %}</select>
   </div><button class="btn btn-outline-primary" type="submit">{{ __('Link', 'secret') }}</button></div>
</form>
{% endif %}

<div class="card"><div class="card-header"><h3 class="card-title"><i class="ti ti-key me-2"></i>{{ _n('Secret', 'Secrets', 2, 'secret') }}</h3></div>
<div class="table-responsive"><table class="table table-hover card-table"><thead><tr><th>{{ __('Name') }}</th><th>{{ __('Type') }}</th><th>{{ __('Username', 'secret') }}</th><th>{{ __('Expiration') }}</th><th>{{ __('Actions') }}</th></tr></thead><tbody>
{% for secret in secrets %}<tr><td><a href="{{ secret.form_url }}"><i class="ti ti-key me-1"></i>{{ secret.name }}</a></td><td>{{ secret.type_label }}</td><td>{{ secret.username ?? '—' }}</td><td>{{ secret.expiration ?? secret.expiration_policy }}</td><td>
   {% if secret.can_reveal %}<button type="button" class="btn btn-sm btn-outline-primary plugin-secret-action" data-action="view" data-url="{{ path('plugins/secret/Secret/' ~ secret.id ~ '/Reveal') }}" data-secret-type="{{ secret.type }}" data-itemtype="{{ item.getType() }}" data-items-id="{{ item.getID() }}" data-csrf="{{ csrf_token(true) }}"><i class="ti ti-eye"></i> {{ __('Reveal', 'secret') }}</button>{% else %}<span class="text-secondary">{{ __('Not available', 'secret') }}</span>{% endif %}
   <div class="plugin-secret-revealed mt-2" hidden></div>
</td></tr>{% else %}<tr><td colspan="5" class="text-center text-secondary py-4">{{ __('No visible secret.', 'secret') }}</td></tr>{% endfor %}
</tbody></table></div></div>
{% if total > 50 %}<div class="d-flex justify-content-between mt-3">
   {% if page > 0 %}<a class="btn btn-outline-secondary" href="{{ page_url ~ (page - 1) }}">{{ __('Previous') }}</a>{% else %}<span></span>{% endif %}
   <span>{{ page + 1 }} / {{ (total / 50)|round(0, 'ceil') }}</span>
   {% if (page + 1) * 50 < total %}<a class="btn btn-outline-secondary" href="{{ page_url ~ (page + 1) }}">{{ __('Next') }}</a>{% endif %}
</div>{% endif %}
