<div class="card">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-key me-2"></i>{{ _n('Secret', 'Secrets', 2, 'secret') }}</h3></div>
   <div class="table-responsive"><table class="table table-hover card-table">
      <thead><tr><th>{{ __('Name') }}</th><th>{{ __('Type') }}</th><th>{{ __('Username', 'secret') }}</th><th>{{ __('Expiration') }}</th><th>{{ __('Actions') }}</th></tr></thead>
      <tbody>
      {% for secret in secrets %}
         <tr data-secret-row="{{ secret.id }}">
            <td><a href="{{ secret.form_url }}"><i class="ti ti-key me-1"></i>{{ secret.name }}</a></td>
            <td>{{ secret.type_label }}</td><td>{{ secret.username ?? '—' }}</td><td>{{ secret.expiration ?? secret.expiration_policy }}</td>
            <td>{% if secret.can_reveal %}<button type="button" class="btn btn-sm btn-outline-primary plugin-secret-action" data-action="view" data-url="{{ path('plugins/secret/Secret/' ~ secret.id ~ '/Reveal') }}" data-secret-type="{{ secret.type }}" data-itemtype="{{ item.getType() }}" data-items-id="{{ item.getID() }}" data-csrf="{{ csrf_token(true) }}"><i class="ti ti-eye me-1"></i>{{ __('Reveal', 'secret') }}</button>{% else %}<span class="text-secondary">{{ __('Not available', 'secret') }}</span>{% endif %}<div class="plugin-secret-revealed mt-2" hidden></div></td>
         </tr>
      {% else %}<tr><td colspan="5" class="text-center text-secondary py-4">{{ __('No visible secret.', 'secret') }}</td></tr>{% endfor %}
      </tbody>
   </table></div>
   {% if total > 50 %}<div class="card-footer d-flex justify-content-between">
      {% if page > 0 %}<a class="btn btn-outline-secondary" href="{{ page_url ~ (page - 1) }}">{{ __('Previous') }}</a>{% else %}<span></span>{% endif %}
      <span>{{ page + 1 }} / {{ (total / 50)|round(0, 'ceil') }}</span>
      {% if (page + 1) * 50 < total %}<a class="btn btn-outline-secondary" href="{{ page_url ~ (page + 1) }}">{{ __('Next') }}</a>{% endif %}
   </div>{% endif %}
</div>
