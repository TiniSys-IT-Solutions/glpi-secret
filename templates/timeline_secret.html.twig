<div class="read-only-content plugin-secret-timeline-content">
   <div class="d-flex align-items-start justify-content-between gap-3">
      <div>
         <div class="fw-semibold"><i class="ti ti-shield-lock me-1"></i>{{ entry_i.name }}</div>
         {% if entry_i.username %}<div class="small text-secondary">{{ __('Username', 'secret') }} : {{ entry_i.username }}</div>{% endif %}
      </div>
      {% if entry_i.can_manage %}
         <div class="dropdown">
            <button class="btn btn-sm btn-ghost-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ __('Actions') }}"><i class="ti ti-dots-vertical"></i></button>
            <div class="dropdown-menu dropdown-menu-end"><a class="dropdown-item" href="{{ entry_i.manage_url }}"><i class="ti ti-settings me-1"></i>{{ __('Manage', 'secret') }}</a></div>
         </div>
      {% endif %}
   </div>
   <div class="d-flex align-items-center gap-2 mt-2">
      {% if entry_i.can_reveal %}
         <button type="button" class="btn btn-sm btn-outline-primary plugin-secret-action"
                 data-action="view" data-url="{{ path('plugins/secret/Secret/' ~ entry_i.id ~ '/Reveal') }}"
                 data-itemtype="{{ entry_i.itemtype }}" data-items-id="{{ entry_i.items_id }}"
                 data-csrf="{{ csrf_token(true) }}">
            <i class="ti ti-eye me-1"></i>{{ __('Reveal', 'secret') }}
         </button>
         <button type="button" class="btn btn-sm btn-outline-secondary plugin-secret-action"
                 data-action="copy" data-url="{{ path('plugins/secret/Secret/' ~ entry_i.id ~ '/Reveal') }}"
                 data-itemtype="{{ entry_i.itemtype }}" data-items-id="{{ entry_i.items_id }}"
                 data-csrf="{{ csrf_token(true) }}"><i class="ti ti-copy me-1"></i>{{ __('Copy') }}</button>
      {% else %}
         <span class="badge bg-secondary-lt">{{ __('Not available', 'secret') }}</span>
      {% endif %}
   </div>
   <div class="plugin-secret-revealed mt-2" hidden></div>
</div>
