{% if link_form %}<div class="card mb-4"><div class="card-header"><h3 class="card-title"><i class="ti ti-link-plus me-2"></i>{{ __('Link to an asset', 'secret') }}</h3></div><form method="post" action="{{ link_action }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="operation" value="link"><div class="card-body">{{ link_selector|raw }}</div><div class="card-footer text-end"><button class="btn btn-primary" type="submit"><i class="ti ti-link me-1"></i>{{ __('Link') }}</button></div></form></div>{% endif %}
<div class="card"><div class="card-header"><h3 class="card-title">{{ __('Linked items', 'secret') }}</h3></div><div class="table-responsive"><table class="table table-hover card-table"><thead><tr><th>{{ __('Type') }}</th><th>{{ __('Name') }}</th></tr></thead><tbody>
{% for relation in relations %}<tr><td>{{ relation.type_name }}</td><td><a href="{{ relation.url }}">{{ relation.name }}</a></td></tr>{% else %}<tr><td colspan="2" class="text-center text-secondary">{{ __('No item found') }}</td></tr>{% endfor %}
</tbody></table></div></div>
